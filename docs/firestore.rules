rules_version = '2';

// AulaSegura — Firestore security rules
//
// Design posture: deny by default. A rule is added only when the contract in
// CONTEXT.md §6.4 fully determines it; anything else stays closed until the
// feature that needs it is designed.
//
// Every role check reads users/{uid} with get(). Firestore caches identical
// get() calls inside one rule evaluation, so a rule that asks for isDocente()
// and myGroups() performs one document read, not two. The cost is accepted for
// clarity; custom claims are the optimisation path if it ever shows up in the
// bill.
//
// IMPORTANT — denormalisation that these rules rely on:
//   users/{uid}.groupIds holds, for a DOCENTE, the groups they teach, and for a
//   TUTOR, the groups of their children. Without that, "can this tutor read a
//   task for 3° B?" is not expressible: security rules cannot walk
//   studentIds -> groupId. The linking flow must keep it in sync.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return userDoc().data;
    }

    // A deactivated account keeps read access to its own profile on purpose:
    // that document is how the client discovers `active == false` and signs
    // itself out. Everything else is gated behind isActive().
    function isActive() {
      return isSignedIn() && profile().active == true;
    }

    function role() {
      return profile().role;
    }

    function isDirectivo() {
      return isActive() && role() == 'directivo';
    }

    function isDocente() {
      return isActive() && role() == 'docente';
    }

    function isTutor() {
      return isActive() && role() == 'tutor';
    }

    function mySchool() {
      return profile().schoolId;
    }

    function myGroups() {
      return profile().get('groupIds', []);
    }

    function myStudents() {
      return profile().get('studentIds', []);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The tutor self-registration writes users, students and a linking code in
    // ONE batch. `getAfter` sees the post-batch state, so each of the three
    // writes can prove that the other two belong to the same redemption.
    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function codeRef(code) {
      return /databases/$(database)/documents/linkingCodes/$(code);
    }

    // Identity is immutable for every client, including the principal. Only
    // the Admin SDK (seed/account script) may set these fields.
    function immutableSelfKeys() {
      return ['uid', 'email', 'role', 'active', 'schoolId', 'createdAt'];
    }

    // The principal manages staff and families of their own school. `active`
    // is the logical-deactivation flag (Fase 2 bloque 1/2); never a delete.
    // `groupIds` and `studentIds` are the denormalised links the rules read,
    // so assigning them here is what makes a teacher see a new group.
    function principalEditableUserKeys() {
      return [
        'firstName', 'lastName', 'fullName', 'phone', 'photoUrl',
        'photoPublicId', 'subjects', 'groupIds', 'studentIds',
        'preferences', 'active', 'updatedAt'
      ];
    }

    // ---------------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------------

    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (isDirectivo() && resource.data.schoolId == mySchool())
      );

      // The principal may create docente/tutor accounts of their own school.
      // The Auth user is created through a SECONDARY FirebaseApp so the
      // principal's session is not replaced; this clause writes the matching
      // users/{uid} document. A client can never create another directivo,
      // and delete stays forbidden (logical deactivation uses active = false).
      // The registering tutor branch goes FIRST: isDirectivo() reads the
      // caller's own users/{uid}, which does not exist yet during registration,
      // and an error there would stop the rule before the second branch.
      allow create: if
        (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.role == 'tutor'
          && request.resource.data.active == true
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.fullName is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.registrationCode is string
          && request.resource.data.studentIds is list
          && request.resource.data.studentIds.size() == 1
          && get(codeRef(request.resource.data.registrationCode)).data.usedBy == null
          && request.resource.data.schoolId == getAfter(codeRef(request.resource.data.registrationCode)).data.schoolId
          && request.resource.data.studentIds[0] == getAfter(codeRef(request.resource.data.registrationCode)).data.studentId
          // groupIds is what the ticket rules later use to scope a tutor's
          // reads, so it must be exactly the group of the redeemed code. Left
          // unchecked, a client could inject another group and read its tasks.
          && request.resource.data.groupIds == [getAfter(codeRef(request.resource.data.registrationCode)).data.groupId]
          && getAfter(codeRef(request.resource.data.registrationCode)).data.usedBy == uid)
        ||
        (isDirectivo()
          && request.resource.data.uid == uid
          && request.resource.data.schoolId == mySchool()
          && request.resource.data.role in ['docente', 'tutor']
          && request.resource.data.active == true
          && request.resource.data.email is string
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.fullName is string
          && request.resource.data.createdAt is timestamp);
      allow delete: if false;

      // Self-service edits and principal-managed edits share this rule, but
      // the principal is constrained by a field whitelist AND by schoolId.
      // Identity is never writable from a client: whoever could change `role`
      // could promote themselves, and changing `schoolId` would move a user
      // into another school's visibility.
      allow update: if isActive() && (
        // A user edits their own profile. `active` is excluded on purpose so
        // nobody can deactivate their own account; that is the principal's job.
        (request.auth.uid == uid
          && !changedKeys().hasAny(immutableSelfKeys())
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.role == resource.data.role)
        ||
        // The principal edits users of their own school. `changedKeys().hasOnly`
        // is what guarantees no identity field travels in the write.
        (isDirectivo()
          && resource.data.schoolId == mySchool()
          && request.resource.data.schoolId == resource.data.schoolId
          && changedKeys().hasOnly(principalEditableUserKeys()))
      );

      match /fcmTokens/{tokenId} {
        allow read, write: if isActive() && request.auth.uid == uid;
      }

      match /noticeReads/{noticeId} {
        allow read, write: if isActive() && request.auth.uid == uid;
      }
    }

    // ---------------------------------------------------------------------
    // students/{studentId}
    // ---------------------------------------------------------------------

    match /students/{studentId} {
      allow read: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        (isDocente() && resource.data.groupId in myGroups()) ||
        (isTutor() && request.auth.uid in resource.data.tutorIds)
      );
      allow create: if isDirectivo()
        && request.resource.data.schoolId == mySchool();
      // A registering tutor may add only themselves, only once, and only when
      // the same batch created their account from the code for THIS student.
      // This branch goes FIRST on purpose: isDirectivo() would read the
      // caller's users/{uid}, which exists only as a pending write in this
      // batch. get() asks the pre-batch state, returns null, and the error
      // evaluates the whole allow to "denied" instead of falling through.
      allow update: if
        (isSignedIn()
          && request.auth.uid in request.resource.data.tutorIds
          && !(request.auth.uid in resource.data.tutorIds)
          && changedKeys().hasOnly(['tutorIds', 'updatedAt'])
          && getAfter(userRef(request.auth.uid)).data.role == 'tutor'
          && studentId in getAfter(userRef(request.auth.uid)).data.studentIds
          && getAfter(codeRef(getAfter(userRef(request.auth.uid)).data.registrationCode)).data.studentId == studentId
          && getAfter(userRef(request.auth.uid)).data.schoolId == resource.data.schoolId)
        ||
        (isDirectivo() && request.resource.data.schoolId == mySchool());
      allow delete: if isDirectivo() && resource.data.schoolId == mySchool();
    }

    // ---------------------------------------------------------------------
    // groups/{groupId}
    // ---------------------------------------------------------------------

    match /groups/{groupId} {
      allow read: if isActive() && resource.data.schoolId == mySchool();
      allow create, update: if isDirectivo()
        && request.resource.data.schoolId == mySchool();
      allow delete: if isDirectivo() && resource.data.schoolId == mySchool();

      match /schedule/{slotId} {
        allow read: if isActive() && get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.schoolId == mySchool();
        allow create, update, delete: if isDirectivo() && get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.schoolId == mySchool();
      }
    }

    // ---------------------------------------------------------------------
    // schools/{schoolId}
    // ---------------------------------------------------------------------

    match /schools/{schoolId} {
      allow read: if isActive() && schoolId == mySchool();
      allow update: if isDirectivo() && schoolId == mySchool()
        && !changedKeys().hasAny(['key', 'createdAt']);
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------------
    // attendanceSessions/{sessionId}
    // ---------------------------------------------------------------------

    match /attendanceSessions/{sessionId} {
      allow read: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        (isDocente() && resource.data.teacherId == request.auth.uid) ||
        (isDocente() && resource.data.groupId in myGroups()) ||
        (isTutor() && resource.data.groupId in myGroups())
      );

      // A session is created *closed* when the teacher saved it: the id is the
      // client UUID, and the whole point of the offline-first write path is that
      // one idempotent `set` carries the final state (`CONTEXT.md` §8.3). The
      // old `status == 'open'` guard protected nothing — `update` already allows
      // closing the session one write later — and it made every save fail.
      allow create: if isDocente()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.schoolId == mySchool()
        && request.resource.data.groupId in myGroups()
        && request.resource.data.status in ['open', 'closed'];

      allow update: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        (isDocente() && resource.data.teacherId == request.auth.uid)
      );

      allow delete: if false;

      match /records/{studentId} {
        allow read: if isActive() && (
          (isDirectivo() && get(
            /databases/$(database)/documents/attendanceSessions/$(sessionId)
          ).data.schoolId == mySchool()) ||
          (isDocente() && get(
            /databases/$(database)/documents/attendanceSessions/$(sessionId)
          ).data.teacherId == request.auth.uid) ||
          (isTutor() && studentId in myStudents())
        );

        // getAfter(), not get(): the session and its records are written in ONE
        // WriteBatch, so at evaluation time the parent does not exist yet and
        // get() returns null — which denied every save. getAfter() reads the
        // projected state of the batch, which is exactly the check we want.
        allow write: if isActive() && (
          (isDirectivo() && getAfter(
            /databases/$(database)/documents/attendanceSessions/$(sessionId)
          ).data.schoolId == mySchool()) ||
          (isDocente() && getAfter(
            /databases/$(database)/documents/attendanceSessions/$(sessionId)
          ).data.teacherId == request.auth.uid)
        );
      }
    }

    // ---------------------------------------------------------------------
    // incidents/{incidentId}
    // ---------------------------------------------------------------------

    match /incidents/{incidentId} {
      allow read: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        resource.data.reportedBy == request.auth.uid ||
        (isDocente() && resource.data.groupId in myGroups()) ||
        (isTutor() && resource.data.studentId in myStudents())
      );

      allow create: if isDocente()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.schoolId == mySchool()
        && request.resource.data.groupId in myGroups()
        && request.resource.data.status == 'nuevo';

      // A tutor may only acknowledge the incident, never rewrite it.
      allow update: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        (isTutor()
          && changedKeys().hasOnly(['seenByTutorIds'])
          && request.resource.data.seenByTutorIds.hasAll(resource.data.seenByTutorIds)
          && request.auth.uid in request.resource.data.seenByTutorIds)
      );

      // Incidents are evidence. Never deleted from the client.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // tasks/{taskId}
    // ---------------------------------------------------------------------

    match /tasks/{taskId} {
      allow read: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        (isDocente() && resource.data.groupIds.hasAny(myGroups())) ||
        (isTutor() && resource.data.groupIds.hasAny(myGroups()))
      );

      allow create: if isActive()
        && request.resource.data.schoolId == mySchool()
        && request.resource.data.createdBy == request.auth.uid
        && (
          (isDocente()
            && request.resource.data.groupIds.hasAny(myGroups())
            && request.resource.data.groupIds.hasOnly(myGroups()))
          || isDirectivo()
        );

      allow update, delete: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        (isDocente() && resource.data.createdBy == request.auth.uid)
      );
    }

    // ---------------------------------------------------------------------
    // notices/{noticeId}
    // ---------------------------------------------------------------------

    match /notices/{noticeId} {
      allow read: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        (isDocente()
          && resource.data.audience.roles.hasAny(['docente'])
          && resource.data.audience.groupIds.hasAny(myGroups())) ||
        // The tutor's inbox is ONE list query:
        //   notices.whereArrayContains('audience.groupIds', g)
        // Firestore proves a list query only from its own constraints and allows
        // a single array-contains per query, so `audience.roles` must NOT be a
        // condition here: it cannot be proven from that query and the whole read
        // would be denied. Group scoping -- the boundary that keeps another
        // family's notices out -- is untouched. The `tutor` audience check lives
        // in the client (`parentNoticeFrom`) and the teacher panel only publishes
        // to `['tutor']`, so no notice addressed to staff is shown to a family.
        (isTutor()
          && (
            resource.data.audience.groupIds.hasAny(myGroups()) ||
            resource.data.audience.studentIds.hasAny(myStudents())
          ))
      );

      allow create: if isActive()
        && request.resource.data.schoolId == mySchool()
        && request.resource.data.createdBy == request.auth.uid
        && (
          isDirectivo() ||
          (isDocente()
            && request.resource.data.audience.groupIds.hasAny(myGroups())
            && request.resource.data.audience.groupIds.hasOnly(myGroups()))
        );

      allow update, delete: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        (isDocente() && resource.data.createdBy == request.auth.uid)
      );
    }

    // ---------------------------------------------------------------------
    // justifications/{justificationId}
    // ---------------------------------------------------------------------

    match /justifications/{justificationId} {
      allow read: if isActive() && (
        (isDirectivo() && resource.data.schoolId == mySchool()) ||
        resource.data.tutorId == request.auth.uid ||
        (isDocente() && resource.data.groupId in myGroups())
      );

      allow create: if isTutor()
        && request.resource.data.tutorId == request.auth.uid
        && request.resource.data.schoolId == mySchool()
        && request.resource.data.studentId in myStudents()
        && request.resource.data.status == 'pendiente';

      // Only the school decides the outcome. A tutor cannot approve their own
      // justification, which is the whole point of the flow.
      allow update: if isDirectivo()
        && resource.data.schoolId == mySchool()
        && changedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'reviewNote'
        ]);

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // conversations/{conversationId} — metadata only, messages live in RTDB
    // ---------------------------------------------------------------------

    match /conversations/{conversationId} {
      allow read: if isActive() && request.auth.uid in resource.data.participants;

      allow create: if isActive()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if isActive() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // notifications/{notificationId} — one document per recipient
    // ---------------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isActive() && resource.data.userId == request.auth.uid;

      // The recipient may only flip `read`. Creation belongs to the seed
      // script or the console: no client writes notifications for others.
      allow update: if isActive()
        && resource.data.userId == request.auth.uid
        && changedKeys().hasOnly(['read']);

      allow create, delete: if false;
    }

    // ---------------------------------------------------------------------
    // linkingCodes/{code}
    // ---------------------------------------------------------------------

    match /linkingCodes/{code} {
      // No listing: a tutor redeems one exact code, never browses them.
      allow get: if isSignedIn();
      allow list: if isDirectivo();

      allow create: if isDirectivo()
        && request.resource.data.schoolId == mySchool()
        && request.resource.data.createdBy == request.auth.uid
        // groupId is mandatory: the tutor registration copies it into
        // users.groupIds, and the rules use that to scope later reads.
        && request.resource.data.groupId is string;

      // Redemption: the tutor claims a code, and only once. The first branch
      // covers the registration batch, where users/{uid} exists only as a
      // pending write: isTutor() asks get() for the pre-batch state, finds
      // null, and the error would deny the batch, so the signed-in branch is
      // evaluated first and the profile is read with getAfter().
      allow update: if
        (isSignedIn()
          && changedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == request.auth.uid
          && resource.data.usedBy == null
          && getAfter(userRef(request.auth.uid)).data.role == 'tutor'
          && getAfter(userRef(request.auth.uid)).data.registrationCode == code
          && getAfter(userRef(request.auth.uid)).data.studentIds == [resource.data.studentId])
        ||
        (isActive() && isTutor()
          && changedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == request.auth.uid
          && resource.data.usedBy == null);

      allow delete: if false;
    }
  }
}
